{
  "name": "casefile-jobs-desktop",
  "productName": "Casefile Jobs",
  "desktopName": "casefile-jobs-desktop.desktop",
  "version": "1.15.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Casefile Jobs as a desktop app",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "prepare-server": "node scripts/prepare-server.mjs",
    "package:linux": "yarn build && electron-builder --linux --x64",
    "package:windows": "yarn build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@types/node": "^24",
    "electron": "45.3.3",
    "electron-builder": "^26",
    "typescript": "^5"
  },
  "dependenciesMeta": {
    "electron": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.1",
  "author": {
    "name": "Dossier (AienTech)",
    "url": "https://github.com/AienTech/dossier"
  },
  "homepage": "https://github.com/AlienBTw/casefile-jobs",
  "contributors": [
    {
      "name": "Ahmed Louay Araour (AlienBTw)",
      "url": "https://github.com/AlienBTw"
    }
  ]
}
